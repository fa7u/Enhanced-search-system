{
  "entities": {
    "WhitelistEntry": {
      "title": "User Account & Whitelist Entry",
      "description": "An entry representing a registered user, their approval status, and subscription.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "photoURL": { "type": "string" },
        "uid": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "rejected"] },
        "addedAt": { "type": "string", "format": "date-time" },
        "subscriptionExpiry": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["admin", "visitor"] },
        "isFrozen": { "type": "boolean" }
      },
      "required": ["email", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "A system administrator with full access.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/whitelist/{email}": {
      "schema": "WhitelistEntry",
      "description": "Collection of user accounts and approval records."
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "Collection of admins."
    }
  }
}
