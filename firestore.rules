rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
       return isSignedIn() && (
         (request.auth.token.email != null && request.auth.token.email.lower() == "langmix2@gmail.com") ||
         (request.auth.uid == "acCG3siZciQkWN7jRj5FXwGtDCf2") ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         (request.auth.token.email != null && 
          exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.role == "admin") ||
         (request.auth.token.email_verified == true && request.auth.token.email != null && 
          exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.role == "admin")
       );
    }

    function isValidWhitelistEntry(data) {
      return data.email is string && data.email.lower().size() <= 256 &&
             data.addedAt is timestamp &&
             data.role in ["admin", "visitor"];
    }

    // Whitelist collection
    match /whitelist/{email} {
      // Users can check status by email. 
      // We allow any signed-in user to 'get' a document to avoid issues with missing email claims in token.
      // They still can't 'list' the whole collection.
      allow get: if isSignedIn();
      
      // Admins can manage the list
      allow list, create, update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
