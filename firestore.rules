rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
       return isSignedIn() && (
         request.auth.uid == "kQhokyxqh6avfQBvtFb2NDTmx4n1" ||
         request.auth.uid == "acCG3siZciQkWN7jRj5FXwGtDCf2" ||
         (request.auth.token != null && "email" in request.auth.token && (
           request.auth.token.email.lower() == "langmix2@gmail.com" || 
           request.auth.token.email.lower() == "lnagmix2@gmail.com"
         ))
       );
    }

    // Whitelist / Registered Users collection
    match /whitelist/{email} {
      // Users can check their approval status
      allow get: if isSignedIn();

      // New users can register for activation (status: pending)
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.status == "pending")
      );

      // Only admins can list users, update approval/subscription status, or delete
      allow list, update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
