rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
       // Safe access to request.auth.token.email
       return isSignedIn() &&
         request.auth.token.email != null && (
         request.auth.token.email.lower() == "langmix2@gmail.com" ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.role == "admin")
       );
    }

    function isValidWhitelistEntry(data) {
      return data.email is string && data.email.lower().size() <= 256 &&
             data.addedAt is timestamp &&
             data.role in ["admin", "visitor"];
    }

    // Whitelist collection
    match /whitelist/{email} {
      // Users can check their own status - relaxed for diagnosis
      allow get: if isSignedIn();
      
      // Admins can manage the list
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidWhitelistEntry(request.resource.data);
      allow update: if isAdmin() && isValidWhitelistEntry(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admins collection
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
